# HTTPS (automatic Let's Encrypt certificate) + password in front of the
# dashboard. The dashboard can approve posts, so it is never served without auth.
# Only /about, /privacy and /terms are public (Google's OAuth consent screen
# requires a homepage and privacy policy URL).
{$CLIPPER_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	@public path /about /privacy /terms
	handle @public {
		root * /srv/public
		rewrite * {path}.html
		file_server
	}

	handle {
		# basic_auth block with the bcrypt hash, generated by deploy.sh (never in git)
		import /etc/caddy/auth.caddy
		reverse_proxy clipper:8765
	}
}
